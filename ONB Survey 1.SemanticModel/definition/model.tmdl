model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["RutaArchivo","Origen","Encuesta","Pregunta","Respuestas Likert","Escala Likert","Opciones Seleccionadas","Comentarios"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Medidas
ref table Encuesta
ref table Pregunta
ref table 'Respuestas Likert'
ref table 'Escala Likert'
ref table 'Opciones Seleccionadas'
ref table Comentarios
ref table Calendario


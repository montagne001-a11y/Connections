/// Ruta completa del Excel exportado desde Microsoft Forms (tabla "OfficeForms.Table").
/// Cámbiala en Transformar datos > Editar parámetros si el archivo se mueve.
expression RutaArchivo = "C:\Users\Mauricio Montagne\OneDrive - Goddard Enterprises Ltd\Desktop\Claude Cowork\GCG — Encuesta de Satisfacción 1_ Selección e Inducción.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Text

/// Consulta de staging (no se carga al modelo): lee la tabla de Forms una sola vez.
expression Origen =
		let
		    Source = Excel.Workbook(File.Contents(RutaArchivo), null, true),
		    Tabla = Source{[Item = "OfficeForms.Table", Kind = "Table"]}[Data],
		    Tipos = Table.TransformColumnTypes(
		        Tabla,
		        {{"Id", Int64.Type}, {"Hora de inicio", type datetime}, {"Hora de finalización", type datetime}}
		    )
		in
		    Tipos

	annotation PBI_ResultType = Table

